# AeroLicense backend configuration. Copy to backend/.env and fill in.
# Every variable is optional: with none set, the API runs in demo mode
# (SQLite, simulated blockchain, demo chat answers, write endpoints disabled).

# ── Database ───────────────────────────────────────────────────────────────
# SQLAlchemy URL. Default: sqlite:///./aerolicense.db (postgres:// is accepted too).
DATABASE_URL=sqlite:///./aerolicense.db

# ── API security ───────────────────────────────────────────────────────────
# Shared secret for write endpoints (POST /documents/upload, /documents/hash),
# sent by clients as the X-API-Key header. Unset = write endpoints return 503.
AEROLICENSE_API_KEY=change-me-to-a-long-random-string

# Comma-separated CORS allowlist (no "*"). Default: http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com

# Base URL encoded in document QR codes. Default: http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000

# ── Blockchain (optional; demo mode if CONTRACT_ADDRESS is unset) ──────────
BLOCKCHAIN_URL=http://127.0.0.1:8545
# Signing is only allowed on: local, hardhat, sepolia, holesky. Anything else refuses.
BLOCKCHAIN_NETWORK=hardhat
CONTRACT_ADDRESS=0xYourContractAddressHere
# Testnet-only key. Empty = read-only (verify works, uploads are simulated).
PRIVATE_KEY=0xYourTestnetPrivateKeyHere

# ── Chat assistant (optional; demo answers if OPENAI_API_KEY is unset) ─────
OPENAI_API_KEY=sk-your-key-here
# Optional OpenAI-compatible endpoint, e.g. https://api.groq.com/openai/v1
# or https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
# Model id for that provider. Default: gpt-4o-mini
LLM_MODEL=gpt-4o-mini
